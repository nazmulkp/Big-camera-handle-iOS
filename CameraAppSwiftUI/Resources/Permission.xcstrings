        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상에 오디오를 녹음하려면 마이크 접근 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
