          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要麦克风访问权限才能为视频录制音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要麥克風存取權限才能為影片錄製音訊。"
          }
        }
      }
    },
