          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is required to capture photos and videos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a la cámara para capturar fotos y videos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la caméra est nécessaire pour capturer des photos et des vidéos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla fotocamera è necessario per scattare foto e registrare video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真や動画を撮影するには、カメラへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진과 동영상을 촬영하려면 카메라 접근 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera é necessário para capturar fotos e vídeos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для съемки фото и видео требуется доступ к камере."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf ve video çekmek için kamera erişimi gereklidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要相机访问权限才能拍摄照片和视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要相機存取權限才能拍攝照片和影片。"
          }
        }
      }
    },
    "permission.error.microphone_required" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم الوصول إلى الميكروفون لتسجيل الصوت مع مقاطع الفيديو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist erforderlich, um Audio mit deinen Videos aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is required to record audio with your videos."
