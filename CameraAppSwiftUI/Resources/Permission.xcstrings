    "permission.camera.reason" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم الوصول إلى الكاميرا لالتقاط الصور ومقاطع الفيديو مع تحكم يدوي كامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff wird verwendet, um Fotos und Videos mit vollständiger manueller Steuerung aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is used to capture photos and videos with full manual controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara se usa para capturar fotos y videos con controles manuales completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la caméra est utilisé pour capturer des photos et des vidéos avec des contrôles manuels complets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla fotocamera viene utilizzato per scattare foto e registrare video con controlli manuali completi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスは、完全な手動コントロールで写真や動画を撮影するために使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근 권한은 전체 수동 제어로 사진과 동영상을 촬영하는 데 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera é usado para capturar fotos e vídeos com controles manuais completos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере используется для съемки фото и видео с полным ручным управлением."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera erişimi, tam manuel kontrollerle fotoğraf ve video çekmek için kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机访问权限用于通过完整的手动控制拍摄照片和视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機存取權限用於透過完整的手動控制拍攝照片和影片。"
          }
        }
      }
    },
    "permission.error.camera_required" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
