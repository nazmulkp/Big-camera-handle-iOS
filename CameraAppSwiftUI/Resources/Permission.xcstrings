    "permission.privacy.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى صورك ومقاطع الفيديو الخاصة بك على جهازك. نحن لا نصل إليها أو نرفعها أو نخزنها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos und Videos bleiben privat auf deinem Gerät. Wir greifen nicht darauf zu, laden sie nicht hoch und speichern sie nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your photos and videos remain private on your device. We don’t access, upload, or store them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fotos y videos permanecen privados en tu dispositivo. No accedemos a ellos, no los subimos ni los almacenamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos et vidéos restent privées sur votre appareil. Nous n’y accédons pas, ne les téléversons pas et ne les stockons pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue foto e i tuoi video restano privati sul tuo dispositivo. Non li accediamo, carichiamo o archiviamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真や動画はデバイス上で非公開のままです。当社がアクセス、アップロード、保存することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진과 동영상은 기기에 비공개로 유지됩니다. 저희는 접근하거나 업로드하거나 저장하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas fotos e vídeos permanecem privados no seu dispositivo. Nós não acessamos, enviamos nem armazenamos esse conteúdo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши фото и видео остаются приватными на вашем устройстве. Мы не получаем к ним доступ, не загружаем и не храним их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflarınız ve videolarınız cihazınızda gizli kalır. Bunlara erişmeyiz, yüklemeyiz veya saklamayız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的照片和视频会保留在设备上并保持私密。我们不会访问、上传或存储它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的照片和影片會保留在裝置上並保持私密。我們不會存取、上傳或儲存它們。"
          }
        }
      }
    },
