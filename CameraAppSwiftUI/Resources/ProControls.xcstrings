    "pro.hud.zen_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide all controls except shutter, readout, and zoom. Tap the screen to temporarily show the full HUD."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء جميع عناصر التحكم باستثناء زر الالتقاط والقراءات والتكبير. اضغط على الشاشة لإظهار واجهة التحكم الكاملة مؤقتًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez toutes les commandes sauf l’obturateur, les informations et le zoom. Touchez l’écran pour afficher temporairement tout le HUD."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende alle Steuerelemente außer Auslöser, Anzeige und Zoom aus. Tippe auf den Bildschirm, um das vollständige HUD vorübergehend anzuzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde tutti i controlli tranne otturatore, dati e zoom. Tocca lo schermo per mostrare temporaneamente l’HUD completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッター、表示、ズーム以外のすべてのコントロールを非表示にします。画面をタップすると、一時的に完全なHUDを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셔터, 표시 정보, 줌을 제외한 모든 컨트롤을 숨깁니다. 화면을 탭하면 전체 HUD가 잠시 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta todos os controles, exceto obturador, leitura e zoom. Toque na tela para mostrar temporariamente o HUD completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает все элементы управления, кроме спуска, показаний и зума. Коснитесь экрана, чтобы временно показать полный HUD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏除快门、读数和变焦外的所有控制。轻点屏幕可临时显示完整 HUD。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta todos los controles excepto el obturador, la lectura y el zoom. Toca la pantalla para mostrar temporalmente el HUD completo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏除快門、讀數和變焦外的所有控制。點一下螢幕可暫時顯示完整 HUD。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklanşör, okuma ve yakınlaştırma dışında tüm kontrolleri gizler. Tam HUD’u geçici olarak göstermek için ekrana dokunun."
          }
        }
      }
    },
